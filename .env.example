# Пример окружения. Скопируй в .env и подставь свой ключ (реальный .env в .gitignore).
# Ключ выпускается в кабинете партнёра BestChange (Профиль → API to get exchange rates).
BESTCHANGE_API_KEY=your_key_here
# --- Search Console (ES-домен) ---
# GSC_SITE: ресурс в GSC — 'sc-domain:ratescout.oc.com.ar' или 'https://ratescout.oc.com.ar/'
# GSC_SA_JSON: JSON-ключ сервис-аккаунта с доступом к ресурсу (для gsc_report.py / seo_setup.py)
# GSC_VERIFICATION: код из Search Console (Настройки → Подтверждение права собственности),
#   подставляется в <meta name="google-site-verification"> при сборке (см. deploy.yml)
GSC_SITE=sc-domain:ratescout.oc.com.ar
GSC_SA_JSON=
GSC_VERIFICATION=
# --- Blogger: вечные посты-сводки в трёх блогах (workflow blogger.yml, матрица es/en/fr) ---
# Общие OAuth-ключи Desktop-приложения (scope blogger), один Google-аккаунт на все блоги.
# Refresh-токен получается один раз (OAuth Playground), дальше CI меняет его на access-токен.
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
# Числовые id блогов (видны в Atom-ленте блога: tag:blogger.com,1999:blog-<ID>):
BLOGGER_ES_BLOG_ID=4058102092155525402
BLOGGER_EN_BLOG_ID=1472804293788001769
BLOGGER_FR_BLOG_ID=
# Id вечных постов (пусто на первом запуске → скрипт создаст пост и напечатает id в лог):
BLOGGER_ES_POST_ID=
BLOGGER_EN_POST_ID=
BLOGGER_FR_POST_ID=
