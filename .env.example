# Пример окружения. Скопируй в .env и подставь свой ключ (реальный .env в .gitignore).
# Ключ выпускается в кабинете партнёра BestChange (Профиль → API to get exchange rates).
BESTCHANGE_API_KEY=your_key_here
# --- Search Console (ES-домен) ---
# GSC_SITE: ресурс в GSC — 'sc-domain:ratescout.oc.com.ar' или 'https://ratescout.oc.com.ar/'
# GSC_SA_JSON: JSON-ключ сервис-аккаунта с доступом к ресурсу (для gsc_report.py / seo_setup.py)
# GSC_VERIFICATION: код из Search Console (Настройки → Подтверждение права собственности),
#   подставляется в <meta name="google-site-verification"> при сборке (см. deploy.yml)
GSC_SITE=sc-domain:ratescout.oc.com.ar
GSC_SA_JSON=
GSC_VERIFICATION=
